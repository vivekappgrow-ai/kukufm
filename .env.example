# Live room API settings. Start it separately with `npm run rooms`.
ROOMS_PORT=8787
ROOMS_HOST=127.0.0.1
ROOMS_DEMO_MODE=true
ROOMS_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ROOMS_PUBLIC_URL=http://localhost:5173

# Create a LiveKit Cloud project or run a trusted LiveKit SFU.
# Use the WebSocket URL (wss://...) and keep API credentials server-side only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice tutor agent. The agent is explicitly dispatched as this name.
VOICE_AGENT_NAME=studyai-voice-tutor
OPENAI_API_KEY=
CALL_INTERNAL_SECRET=
VOICE_CALL_MAX_SECONDS=600

# Production: set ROOMS_DEMO_MODE=false and use an identity-provider JWT
# signed with this secret (HS256). The server requires `sub`; for minors it
# also requires trusted signed claims ageBand="under18", parentConsent=true.
# Never use the local demo session endpoint for real students.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
